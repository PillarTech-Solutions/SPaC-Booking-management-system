# ==============================================================================
# SPaC Booking Management System — Environment Configuration Template
# ==============================================================================

# --- Client-Side (Vite) Supabase Configuration ---
# Publicly accessible via the browser bundle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-Side Supabase Secrets (Edge Functions / Backend) ---
# NEVER expose to client code or prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- PayMongo Payment Gateway (Edge Functions) ---
PAYMONGO_SECRET_KEY=sk_test_your_stripe_key_here
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google Gmail API Integration (Edge Functions) ---
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=notifications@saranaypickleball.ph
